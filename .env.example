# Kimi (Moonshot AI) — 默认模型，用于速读摘要、分类摘要等
KIMI_API_KEY=your_kimi_api_key_here
# 可选模型: kimi-k2.5 / moonshot-v1-8k / moonshot-v1-32k / moonshot-v1-128k

# DeepSeek — 用于商业机会 & 研发效能机会分析
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Debug mode (显示完整错误信息)
# DEBUG=true

# Database path (optional)
# DATABASE_PATH=./data/tokenburner.db
